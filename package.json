{
	"name": "dsa-woodshed.space",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"description": "The DSA Woodshed — a static SvelteKit reading surface for the DSA study packet (Skeleton 4 + Tailwind v4 + mdsvex).",
	"license": "MIT",
	"packageManager": "pnpm@10.13.1",
	"engines": {
		"node": ">=22 <25"
	},
	"scripts": {
		"prepare": "node scripts/build-tinyvectors.mjs",
		"sync-content": "node scripts/sync-content.mjs",
		"dev": "vite dev",
		"prebuild": "pnpm run verify:content-sync",
		"build": "vite build",
		"postbuild": "pnpm run verify:booklet-build && pnpm run build:search && pnpm run verify:search-index && pnpm run verify:diagrams",
		"build:search": "pagefind --site build",
		"verify:booklet": "node scripts/sync-booklet.mjs --verify",
		"verify:booklet-build": "node scripts/sync-booklet.mjs --verify-build",
		"verify:search-index": "node scripts/verify-search-index.mjs",
		"verify:diagrams": "node scripts/verify-diagrams.mjs",
		"verify:content-sync": "node scripts/verify-content-sync.mjs",
		"verify:repo-profile": "python3 scripts/check-repo-profile.py",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint . && python3 scripts/check-inhouse-package-parity.py && pnpm run verify:repo-profile",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"test": "vitest",
		"test:unit": "vitest run",
		"test:coverage": "vitest run --coverage",
		"test:e2e": "playwright test",
		"optimize:images": "node scripts/optimize-images.js",
		"analyze": "ANALYZE=1 vite build"
	},
	"dependencies": {
		"@fontsource-variable/fraunces": "^5.3.0",
		"@fontsource/crimson-pro": "^5.3.0",
		"@fontsource/inter": "^5.3.0",
		"@lucide/svelte": "^1.47.0",
		"@tummycrypt/tinyvectors": "https://github.com/tinyland-inc/tinyvectors/archive/refs/tags/v0.3.6.tar.gz",
		"effect": "^3.22.2"
	},
	"devDependencies": {
		"@playwright/test": "^1.63.0",
		"@skeletonlabs/skeleton": "4.15.2",
		"@skeletonlabs/skeleton-svelte": "4.15.2",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@tailwindcss/vite": "^4.3.3",
		"@tummycrypt/vite-plugin-a11y": "0.2.2",
		"@tummycrypt/vite-plugin-skeleton-colors": "0.2.2",
		"@types/node": "^22.20.4",
		"@vitest/coverage-v8": "^4.1.10",
		"eslint": "^9.39.5",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.12.0",
		"mdsvex": "0.12.8",
		"mermaid-isomorphic": "^3.1.0",
		"pagefind": "^1.5.2",
		"playwright": "^1.63.0",
		"prettier": "^3.9.8",
		"prettier-plugin-svelte": "^4.1.1",
		"rollup-plugin-visualizer": "^7.1.1",
		"serve": "^14.2.6",
		"sharp": "^0.35.4",
		"shiki": "^4.4.3",
		"svelte": "^5.57.1",
		"svelte-check": "^4.7.6",
		"svgo": "^4.1.0",
		"tailwindcss": "^4.3.3",
		"tsx": "^4.23.13",
		"typescript": "6.0.3",
		"typescript-eslint": "^8.70.0",
		"vite": "^8.3.0",
		"vitest": "^4.1.10"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"@tailwindcss/oxide",
			"esbuild",
			"sharp"
		]
	}
}
