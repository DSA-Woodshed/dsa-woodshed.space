# Dependencies
node_modules/
.pnpm-store/

# Build outputs
.svelte-kit/
build/
dist/

# Bazel derived outputs
/bazel-*
user.bazelrc

# Synced content (BUILD INPUT). The prose/reference SSOT is the DSA study packet;
# scripts/sync-content.mjs regenerates these from a packet checkout. The manifest
# is committed (it feeds the on-site content registry and pins the source commit);
# the rendered bodies are not, mirroring the packet's generated-artifacts rule.
# Regenerate with `pnpm run sync-content` (or `just build`).
src/content/**
!src/content/.manifest.json
static/fonts/
static/capabilities.json.tmp-*
static/generated/booklet-*.pdf

# Bundle analysis artifacts.
.bundle-stats/

# Build-time Mermaid render cache (content-addressed by diagram source hash).
# See src/lib/docs/mermaid.ts. Pure build optimization, safe to delete/regenerate.
.mermaid-cache/

# Environment files
.env
.env.local
.env.*.local
!.env.example

# Logs
logs/
*.log

# Test artifacts
test-results/
playwright-report/
coverage/
.lighthouseci/
bundle-report.json

# Editor
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

